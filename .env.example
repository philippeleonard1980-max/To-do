# ---------------------------------------------------------------------------
# AI Talk - environment configuration
# Copy to `.env` and fill in. Every value below has a working default except
# ANTHROPIC_API_KEY; without that key the app runs on the built-in mock model
# so you can click through the entire product offline.
# ---------------------------------------------------------------------------

# Database (SQLite by default; any Prisma-supported URL works)
DATABASE_URL="file:./dev.db"

# Session signing secret. MUST be changed for anything public.
# Generate one with: openssl rand -base64 48
AUTH_SECRET="dev-only-insecure-secret-change-me-before-deploying-anywhere"

# --- Model providers ------------------------------------------------------
# Providers are selected per model, not globally: a Claude model routes to
# Anthropic, a Gemini model to Google. A vendor with no key here falls back to
# the built-in offline model, so the app always runs.
#
# Set AI_PROVIDER="mock" to force every model onto the offline model.
# AI_PROVIDER=""

ANTHROPIC_API_KEY=""

# Google Gemini. Get a key at https://aistudio.google.com/apikey — the free
# tier is enough to run this app.
#
# Note: a Gemini Advanced / Google One AI Premium subscription is a consumer
# product and does NOT grant API access. The API key above is separate and is
# what this app needs.
GEMINI_API_KEY=""

# Default model id used for new chats.
DEFAULT_MODEL="claude-sonnet-5"

# --- Product limits -------------------------------------------------------
# Monthly message credits granted per plan tier.
CREDITS_FREE=300
CREDITS_PLUS=3000
CREDITS_PRO=20000

# Set to "true" to let anyone register. "false" makes it invite-only.
ALLOW_SIGNUPS="true"
